# Copy to backend/.env and fill in. Defaults match docker-compose.yml.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://scraper:scraper@localhost:5432/smart_web_scraper

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Required for extraction. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=

# Optional tuning (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
# PLAYWRIGHT_ENABLED=true
# WORKER_ENABLED=true
# JOBS_PER_HOUR=30
# MAX_ACTIVE_JOBS_PER_USER=5
